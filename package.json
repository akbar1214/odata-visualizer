{
  "name": "odata-visualizer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @odata-visualizer/shared build && pnpm --filter @odata-visualizer/mcp build && concurrently \"pnpm --filter @odata-visualizer/backend dev\" \"pnpm --filter @odata-visualizer/frontend dev\"",
    "build": "pnpm -r build",
    "lint": "oxlint packages/*/src",
    "lint:fix": "oxlint --fix packages/*/src",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:watch": "pnpm -r test:watch",
    "mcp:build": "pnpm --filter @odata-visualizer/mcp build",
    "mcp:start": "pnpm --filter @odata-visualizer/mcp start",
    "mcp:typecheck": "pnpm --filter @odata-visualizer/mcp typecheck",
    "container:build": "docker build -f container/Containerfile -t odata-visualizer .",
    "container:run": "docker run -p 3001:3001 odata-visualizer"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "oxlint": "^1.74.0",
    "prettier": "^3.9.5",
    "typescript": "^5.4.5"
  }
}
