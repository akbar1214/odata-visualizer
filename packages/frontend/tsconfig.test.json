{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Only used for typechecking, so the build's rootDir/outDir do not apply.
    "rootDir": ".",
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "__tests__/**/*.ts", "__tests__/**/*.tsx"],
  "exclude": ["node_modules", "dist"]
}
